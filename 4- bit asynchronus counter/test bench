`timescale 1ns / 1ps

module tb_async_counter;

reg clk;
reg reset;
wire [3:0] q;

// Instantiate the DUT
async_counter uut (
    .clk(clk),
    .reset(reset),
    .q(q)
);

// Clock Generation
initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

// Stimulus
initial
begin
    $display("Time\tReset\tCounter");
    $monitor("%0t\t%b\t%b",$time,reset,q);

    reset = 1;
    #15;

    reset = 0;

    #170;

    $finish;
end

endmodule